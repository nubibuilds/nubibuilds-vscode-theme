{
  "name": "nubibuilds-dark",
  "displayName": "NubiBuilds Dark",
  "description": "A green-phosphor terminal dark theme: one green accent and four supporting colours, each with a fixed job. Includes three background variants — Dark, Dark Void and Dark Float — with WCAG-checked contrast and full semantic highlighting.",
  "version": "0.1.1",
  "publisher": "danaharliansyah",
  "author": {
    "name": "Dana Harliansyah"
  },
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nubibuilds/nubibuilds-vscode-theme.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark theme",
    "dark",
    "green",
    "terminal",
    "phosphor",
    "minimal",
    "retro",
    "semantic highlighting"
  ],
  "contributes": {
    "themes": [
      {
        "label": "NubiBuilds Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/nubibuilds-dark-color-theme.json"
      },
      {
        "label": "NubiBuilds Dark Void",
        "uiTheme": "vs-dark",
        "path": "./themes/nubibuilds-dark-void-color-theme.json"
      },
      {
        "label": "NubiBuilds Dark Float",
        "uiTheme": "vs-dark",
        "path": "./themes/nubibuilds-dark-float-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-theme.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check": "node scripts/check-contrast.mjs && node scripts/check-coverage.mjs",
    "package": "npm run build && npm run check && npx --yes @vscode/vsce package"
  }
}
